# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local staat in .gitignore en wordt nooit gecommit.

# Supabase (Settings → API in het Supabase-dashboard)
SUPABASE_URL=https://JOUW-PROJECT.supabase.co
# LET OP: de service role key is geheim — nooit delen of committen.
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key

# Resend (API Keys in het Resend-dashboard)
RESEND_API_KEY=re_jouw_api_key
# Sandbox-afzender werkt zonder domeinverificatie. Na verificatie van een
# eigen domein in Resend vervangen door bv. no-reply@sonnenwiese.nl.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Ontvanger van boekingsaanvragen (de eigenaar). Aanpassen = alleen deze
# regel wijzigen (en op Vercel: de env var), geen codewijziging nodig.
# Dit is een publieke repo — zet hier nooit een echt e-mailadres in.
OWNER_NOTIFICATION_EMAIL=eigenaar@voorbeeld.nl

# Wachtwoord voor de beheerpagina (/admin)
ADMIN_PASSWORD=kies-een-sterk-wachtwoord

# Basis-URL van de site, gebruikt in e-maillinks en metadata.
# Zonder www: het apex-domein is het canonieke adres.
SITE_URL=https://sonnenwiese.nl
