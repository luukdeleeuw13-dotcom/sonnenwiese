# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local staat in .gitignore en wordt nooit gecommit.

# Supabase (Settings → API in het Supabase-dashboard)
SUPABASE_URL=https://JOUW-PROJECT.supabase.co
# LET OP: de service role key is geheim — nooit delen of committen.
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key

# Resend (API Keys in het Resend-dashboard)
RESEND_API_KEY=re_jouw_api_key
# Sandbox-afzender werkt zonder domeinverificatie. Na verificatie van een
# eigen domein in Resend vervangen door bv. no-reply@sonnenwiese.nl.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Ontvangers van boekingsaanvragen. Meerdere adressen mogen, gescheiden
# door komma's — ze krijgen allemaal dezelfde melding mét accepteer- en
# afwijsknoppen, zodat een aanvraag niet in één inbox blijft liggen.
# Zet de eigenaar vooraan: op dat eerste adres worden de handmatige
# blokkades in de agenda gezet.
# Aanpassen = alleen deze regel wijzigen (en op Vercel: de env var).
# Dit is een publieke repo — zet hier nooit een echt e-mailadres in.
OWNER_NOTIFICATION_EMAIL=eigenaar@voorbeeld.nl,meekijker@voorbeeld.nl

# De rekening waar het betaalverzoek naartoe wijst. Beide zijn nodig:
# zonder een van de twee gaat er geen betaalverzoek uit, want een gast die
# wél weet dát hij moet betalen maar niet waarheen, is slechter af dan een
# gast die nog niets gehoord heeft.
# Dit is een publieke repo — zet hier nooit een echt rekeningnummer in.
# De tenaamstelling moet precies zo luiden als bij de bank; die naam neemt
# de gast over in zijn bankapp.
OWNER_IBAN=AT00 0000 0000 0000 0000
OWNER_ACCOUNT_NAME=Voorbeeld Achternaam

# Alleen op Vercel: token dat Vercel meestuurt bij de automatische taken
# (keepalive, opruimen, wekelijkse back-up, betaalcontrole). Staat hij
# ingesteld, dan weigeren die taken elke aanroep van buitenaf. Lokaal niet
# nodig.
CRON_SECRET=een-lange-willekeurige-reeks

# Wachtwoord voor de beheerpagina (/admin)
ADMIN_PASSWORD=kies-een-sterk-wachtwoord

# Basis-URL van de site, gebruikt in e-maillinks en metadata.
# Zonder www: het apex-domein is het canonieke adres.
SITE_URL=https://sonnenwiese.nl
